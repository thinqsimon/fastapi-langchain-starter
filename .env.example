# 이 파일을 복사해 .env를 만든다: cp .env.example .env
# 새 설정을 추가하면 backend/src/app/core/config.py 와 이 파일을 함께 수정한다.

# ---- App ----
APP_NAME="AX Chat Starter"
APP_ENV=local                 # local | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ---- Database (docker compose의 db 서비스와 일치) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# ---- Auth ----
JWT_SECRET_KEY=change-me      # 운영에서는 `openssl rand -hex 32` 값 사용
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- LLM (LangChain init_chat_model) ----
LLM_PROVIDER=openai           # openai | anthropic | google_genai | fake(키 없이 테스트)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=                 # 강의 제공 게이트웨이 등 OpenAI 호환 엔드포인트일 때만
LLM_TEMPERATURE=0.3
RAG_ENABLED=false

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
