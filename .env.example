# 이 파일을 복사해 .env를 만든다: cp .env.example .env
# 새 설정을 추가하면 backend/src/app/core/config.py 와 이 파일을 함께 수정한다.
# .env에는 실제 비밀값이 들어가므로 절대 커밋하지 않는다(.gitignore에 있음).

# ---- App ----
APP_PROFILE=diary-coach       # starter | diary-coach. 프론트엔드 프로필과 맞춘다.
APP_NAME=                    # 비우면 프로필 이름. 다른 서비스 이름으로 바꿀 수 있다.
APP_ENV=local                 # local | test | production
LOG_LEVEL=INFO
# JSON 배열과 쉼표 구분 둘 다 됩니다.
#   ["https://내앱.vercel.app","http://localhost:3000"]
#   https://내앱.vercel.app, http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ---- Database (docker compose의 db 서비스와 일치) ----
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# 이미 5432를 쓰는 PostgreSQL이 있으면 다른 포트로 바꾸고 아래 DATABASE_URL도 함께 고친다.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# 테스트 전용 DB. DATABASE_URL을 원격(Supabase 등)으로 바꿔도 테스트는 항상 이쪽을 쓴다.
# 운영 데이터에 테스트가 붙는 사고를 막기 위한 분리다.
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# ---- Auth ----
# 운영(APP_ENV=production)에서는 아래 기본값을 쓰면 서버가 뜨지 않는다.
# `openssl rand -hex 32`로 만든 값을 넣을 것.
JWT_SECRET_KEY=dev-only-insecure-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- LLM (LangChain init_chat_model) ----
# 공급자 교체는 코드 수정 없이 아래 두 줄만 바꾸면 된다.
LLM_PROVIDER=openai           # openai | anthropic | google_genai | fake(키 없이 테스트)
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3            # OpenAI·Gemini에만 보낸다. Claude는 API가 거부해 보내지 않는다
LLM_BASE_URL=                 # OpenAI 호환 게이트웨이를 쓸 때만

# 키는 LLM_API_KEY 또는 공급자 표준 이름 중 하나에 넣는다(LLM_API_KEY가 우선).
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 토큰 단가(100만 토큰당 USD). 비우면 backend/src/app/llm/pricing.py의 기본 표를 쓴다.
# 공급자가 단가를 바꾸거나 표에 없는 모델을 쓸 때 직접 지정한다.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# "서버 설정" 화면(ADMIN-01)에 들어갈 수 있는 이메일. 쉼표로 여러 명.
ADMIN_EMAILS=
# 서버 설정 화면에서 입력한 OpenAI/Gemini/Claude API 키를 DB에 암호화해 저장하는 키.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 운영에서 이 값을 바꾸면 이미 저장된 키를 복호화할 수 없게 되니, 바꿀 때는 화면에서 키를 다시 입력한다.
SETTINGS_ENCRYPTION_KEY=
# 관리자가 "이 계정으로 테스트"(ADMIN-02)를 시작했을 때 그 세션이 유지되는 시간(분)
ADMIN_TEST_TOKEN_EXPIRE_MINUTES=60
# 관리자 화면 "비밀번호 초기화"(ADMIN-05)에서 '기본 암호로'를 고르면 쓰는 값. 비우면 12345678. 8~72자.
ADMIN_RESET_PASSWORD_DEFAULT=

# 선택 기능: 문서를 저장해 두고 질문과 비슷한 대목을 찾는 기능(RAG).
# false면 관련 API가 아예 등록되지 않습니다.
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4

# ---- Frontend ----
NEXT_PUBLIC_APP_PROFILE=diary-coach
NEXT_PUBLIC_APP_NAME=         # 비우면 프로필 이름. 프론트엔드 빌드 시 적용된다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
